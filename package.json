{
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/three": "0.185.4",
    "three-bvh-csg": "0.0.18",
    "three-mesh-bvh": "0.9.10",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "wrangler": "4.131.1"
  },
  "name": "timber-atlas",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "cloudflare:prepare": "node deployment/cloudflare/prepare.mjs",
    "cloudflare:run": "node deployment/cloudflare/run.mjs",
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "model:joints": "tsx scripts/build-joints.ts && tsx scripts/build-bracket-joints.ts",
    "model:roof": "tsx scripts/build-roof-joints.ts",
    "model:walls": "tsx scripts/build-wall-joints.ts",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "tsx --test tests/*.test.ts",
    "test:cloudflare": "node --test deployment/cloudflare/cloudflare.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.1.0"
}
